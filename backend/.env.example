# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Development: * lets phones/emulators on your LAN reach the server. Production: list real hostnames.
# Set True when reaching the backend through an HTTPS tunnel/proxy such as ngrok.
TRUST_X_FORWARDED_PROTO=False
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# --- Database ---
# Leave unset to use the local SQLite file (backend/db.sqlite3).
# PostgreSQL example:
# DATABASE_URL=postgres://civiceye:password@localhost:5432/civiceye

# --- CORS (needed for the web dashboard; the mobile app does not use CORS) ---
# Development: the Vite dev server. Production: the dashboard's https origin.
CORS_ALLOWED_ORIGINS=http://localhost:5181,http://127.0.0.1:5181,https://mooned-glimpse-cinch.ngrok-free.dev
CSRF_TRUSTED_ORIGINS=

# --- Auth ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Uploads ---
MAX_IMAGE_SIZE_MB=8
USE_S3=False
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Email (console backend prints emails, including password reset codes, to the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CivicEye <no-reply@civiceye.local>

# --- Background jobs ---
# True runs tasks inline (no Redis needed). Set False and run a Celery worker + beat in production.
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Push notifications (Expo) ---
EXPO_PUSH_ENABLED=False
EXPO_ACCESS_TOKEN=

# --- Citizen OTP sign-in ---
# DEVELOPMENT ONLY: fixed code accepted for every mobile number, no SMS sent.
# Ignored unless DEBUG=True, and the server refuses to start with it when DEBUG=False.
OTP_TEST_CODE=
# SMS_BACKEND=apps.accounts.sms.TwilioSMSBackend
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
