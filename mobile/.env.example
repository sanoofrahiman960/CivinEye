# Copy to .env (never commit .env). Restart Expo after changing it.

# Backend URL. Leave unset in development: the app reuses the Expo dev-server host on port 8001.
#   Android emulator: http://10.0.2.2:8001
#   iOS simulator:    http://localhost:8001
#   Physical device:  http://<your computer's LAN IP>:8001, or an ngrok tunnel (ngrok http 8001)
#   Production:       https://api.your-city.gov
# EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok-free.dev

# Google Maps keys: only needed for development/store builds (Expo Go and GPS work without them).
# Restrict each key to the app's package name / bundle ID in Google Cloud Console.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# EAS_PROJECT_ID=
# ANDROID_PACKAGE=com.civiceye.app
# IOS_BUNDLE_ID=com.civiceye.app
